# Modèle du fichier .env (sans vrais mots de passe).
# Copier ce fichier en ".env" puis remplir les valeurs.

# ---------- Base de données PostgreSQL ----------
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/tomes_club?schema=public"

# ---------- LiveKit (appels vidéo) ----------
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"

# ---------- Authentification (Better Auth) ----------
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="CLE_SECRETE_ALEATOIRE"
BETTER_AUTH_URL="http://localhost:3000"
# Autres adresses autorisées (ex : http://192.168.1.82:3000), séparées par des virgules, sans espace
BETTER_AUTH_TRUSTED_ORIGINS=""

# ---------- Connexion avec Google ----------
# À créer sur https://console.cloud.google.com (voir README)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Connexion administrateur ----------
ADMIN_USERNAME="NOM_ADMIN"
ADMIN_PASSWORD="MOT_DE_PASSE_ADMIN"

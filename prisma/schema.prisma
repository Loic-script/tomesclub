// Structure de la base de données (les tables).
// Après une modification : npm run db:migrate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================================================================
// Authentification (tables utilisées par Better Auth)
// Ne pas renommer ces champs : Better Auth les utilise tels quels.
// ===================================================================

/// Un utilisateur de l'application
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Appels vidéo
  callsCreated      Call[]            @relation("CallsCreated")
  callParticipation CallParticipant[]

  // Fiche remplie après la première connexion
  profile Profile?

  // Salles de groupe créées + file d'attente "appel au hasard"
  roomsCreated Room[]      @relation("RoomsCreated")
  roomInvites  RoomInvite[]
  paymentProofs PaymentProof[]
  eventResponses EventResponse[]
  matchQueue   MatchQueue?

  // Les notifications reçues (appels, événements, annonces)
  notifications Notification[]

  // La discussion avec le coach (admin)
  coachMessages CoachMessage[]

  // Abonnements : les membres que je suis, et ceux qui me suivent
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  @@map("user")
}

/// Une connexion active (un navigateur connecté)
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Une façon de se connecter (ici : email + mot de passe chiffré)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Codes temporaires (vérification d'email, mot de passe oublié...)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===================================================================
// Fiche membre (formulaire d'accueil après la 1re connexion)
// ===================================================================

/// Les réponses du formulaire d'accueil d'un membre.
model Profile {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  birthDate    DateTime?
  country      String?
  city         String? // où il habite
  phone        String?
  /// Occupations cochées, avec le détail de chacune :
  /// [{ "kind": "student", "detail": "informatique" }, ...]
  occupations  Json?
  languages    String[]  @default([]) // langues parlées
  englishLevel String? // beginner | elementary | intermediate | advanced
  /// Le type confirmé : member (tout le monde au départ) | leader | teacher
  role         String    @default("member")
  /// La demande en attente de validation par l admin : leader | teacher (null = aucune)
  roleRequest  String?
  interests    String[]  @default([]) // centres d'intérêt
  photo        Bytes? // la photo du membre (petite image)
  photoType    String? // ex : image/jpeg
  completedAt  DateTime? // rempli = formulaire terminé
  /// Réglages des notifications (le membre peut les couper)
  notifyCalls  Boolean   @default(true) // quand on m'appelle
  notifyEvents Boolean   @default(true) // nouveaux événements et annonces
  notifyFollows Boolean  @default(true) // quand quelqu'un m'ajoute (follow)
  notifyRooms   Boolean  @default(true) // quand une salle de groupe s'ouvre
  /// Dernier signe de vie du navigateur : sert à afficher le point vert "en ligne"
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@map("profile")
}

// ===================================================================
// Appels vidéo
// ===================================================================

/// Un appel vidéo. Son id sert aussi de nom de salle dans LiveKit.
model Call {
  id           String            @id @default(cuid())
  createdById  String
  createdBy    User              @relation("CallsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  participants CallParticipant[]

  @@index([createdById])
  @@map("call")
}

/// Une personne qui a le droit d'entrer dans l'appel (le créateur aussi).
model CallParticipant {
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId])
  @@map("call_participant")
}

// ===================================================================
// Salles de groupe, événements, recherche d'appel au hasard
// ===================================================================

/// Une salle de groupe. Salle LiveKit : "room_<id>".
/// Privée = cachée de la liste publique, on y entre seulement avec le lien.
model Room {
  id          String   @id @default(cuid())
  name        String
  topic       String? // le thème de la conversation (proposé ou écrit par l hôte)
  isPrivate   Boolean  @default(false)
  /// L activité choisie (clé du catalogue : "debate", "open-discussion"...)
  activity    String?
  description String?
  format      String? // ex : "Team debate", "Breakout pairs"
  level       String? // all | beginner | elementary | intermediate | advanced
  durationMin Int? // 1 à 30 minutes
  maxParticipants Int? // limite choisie par l hôte (2 à 20)
  /// null = salle ouverte par le coach (session admin, sans compte membre)
  createdById String?
  createdBy   User?    @relation("RoomsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  /// Salle privée d un Leader / Teacher : en attente de l accord de l admin (pas encore dans LiveKit)
  pendingApproval Boolean @default(false)
  /// Salle privée payante : comment l hôte a payé l admin (mvola | orange), la référence et le montant (Ar)
  paymentMethod String?
  paymentRef    String?
  paymentAmount Int?
  /// Ou une capture d écran du paiement (table payment_proof)
  paymentProofId String?
  /// Les membres invités par l hôte (salle privée)
  invites     RoomInvite[]
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@map("room")
}

/// Un membre invité dans une salle privée.
model RoomInvite {
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([roomId, userId])
  @@index([userId])
  @@map("room_invite")
}

/// Un événement du club (cours programmé...) ou une annonce de l'admin.
model Event {
  id          String    @id @default(cuid())
  kind        String // "event" (avec date) | "announcement" (annonce)
  title       String
  description String?
  startsAt    DateTime? // la date du cours/événement (null pour une annonce)
  image       Bytes? // l'image de la carte (facultative)
  imageType   String? // ex : image/jpeg
  /// Le direct vidéo de l événement : lancé par l admin, terminé par l admin.
  liveStartedAt DateTime?
  liveEndedAt   DateTime?
  /// Payant ou gratuit. Si payant : le tarif (nombre entier) et la monnaie (Ar, €, $).
  isPaid      Boolean   @default(false)
  price       Int?
  currency    String?
  createdAt   DateTime  @default(now())
  responses   EventResponse[]

  @@index([kind, startsAt])
  @@map("event")
}

/// Un membre inscrit à un événement (status = "registered").
model EventResponse {
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String // registered
  /// Événement payant : la date où l admin a confirmé le paiement (null = pas encore payé)
  paidAt    DateTime?
  /// Événement payant : la référence MVola donnée par le membre, et/ou sa capture d écran
  paymentRef     String?
  paymentProofId String?
  createdAt DateTime @default(now())

  @@id([eventId, userId, status])
  @@index([userId])
  @@map("event_response")
}

/// File d'attente du "practice with a random partner" : une ligne = une personne qui cherche.
model MatchQueue {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("match_queue")
}

// ===================================================================
// Notifications
// ===================================================================

/// Une notification reçue par un membre.
/// `kind` : "call" (un appel) | "event" (événement) | "announcement" (annonce)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  /// Le lien à ouvrir quand on touche la notification (ex : /call/abc)
  link      String?
  readAt    DateTime? // null = pas encore lue
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

// ===================================================================
// Abonnements (suivre un membre)
// ===================================================================

/// "follower" suit "following".
model Follow {
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follow")
}

// ===================================================================
// Notifications de l admin (nouveaux membres, salles, participants...)
// ===================================================================

/// Ce que l admin doit savoir. Il n y a qu un admin : pas de userId.
model AdminNotification {
  id        String    @id @default(cuid())
  kind      String // member | room | event | call
  title     String
  body      String?
  link      String?
  readAt    DateTime? // null = pas encore lue
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@map("admin_notification")
}

/// Une activité de room ajoutée par l admin (en plus des 13 du catalogue).
model CustomActivity {
  id          String   @id @default(cuid())
  key         String   @unique // "custom-..." : utilisée dans Room.activity
  icon        String
  name        String
  description String
  /// [{ name: "Catégorie", topics: ["Thème 1", ...] }]
  categories  Json
  formats     String[]
  createdAt   DateTime @default(now())

  @@map("custom_activity")
}

/// Un fichier joint a une activite de room (PowerPoint, PDF, photo, video...).
/// Le fichier est sur le disque (volume), pas dans la base.
model ActivityFile {
  id          String   @id
  /// La cle de l activite (catalogue ou "custom-...")
  activityKey String
  /// Le nom d origine, ex : "Debate rules.pptx"
  name        String
  mime        String
  size        Int
  /// pdf | image | video | audio | office | other
  kind        String
  /// Pour PowerPoint / Word / Excel : la version PDF (pending | ready | failed)
  pdfStatus   String?
  createdAt   DateTime @default(now())

  @@index([activityKey])
  @@map("activity_file")
}

// ===================================================================
// Messages entre le coach (admin) et un membre
// ===================================================================

/// Un message de la discussion "coach <-> membre". Une discussion par membre.
model CoachMessage {
  id        String    @id @default(cuid())
  /// Le membre de cette discussion
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// true = ecrit par le coach, false = ecrit par le membre
  fromCoach Boolean
  /// Le texte (vide si le message est seulement un fichier)
  body      String
  /// Un fichier joint (photo, video, document...) : sur le disque, dossier chat-files/<id du message>
  fileName  String?
  fileMime  String?
  fileSize  Int?
  /// pdf | image | video | audio | office | other
  fileKind  String?
  /// Lu par celui qui le recoit (null = pas encore lu)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([fromCoach, readAt])
  @@map("coach_message")
}

/// Une capture d écran de paiement MVola envoyée par un membre (salle privée, événement payant).
/// L image est sur le disque : <dossier des fichiers>/payment-proofs/<id>.<ext>
model PaymentProof {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("payment_proof")
}

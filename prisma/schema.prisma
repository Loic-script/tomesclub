// Structure de la base de données (les tables).
// Après une modification : npm run db:migrate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================================================================
// Authentification (tables utilisées par Better Auth)
// Ne pas renommer ces champs : Better Auth les utilise tels quels.
// ===================================================================

/// Un utilisateur de l'application
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Appels vidéo
  callsCreated      Call[]            @relation("CallsCreated")
  callParticipation CallParticipant[]

  // Fiche remplie après la première connexion
  profile Profile?

  // Salles de groupe créées + file d'attente "appel au hasard"
  roomsCreated Room[]      @relation("RoomsCreated")
  matchQueue   MatchQueue?

  @@map("user")
}

/// Une connexion active (un navigateur connecté)
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Une façon de se connecter (ici : email + mot de passe chiffré)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Codes temporaires (vérification d'email, mot de passe oublié...)
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===================================================================
// Fiche membre (formulaire d'accueil après la 1re connexion)
// ===================================================================

/// Les réponses du formulaire d'accueil d'un membre.
model Profile {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  birthDate    DateTime?
  country      String?
  city         String? // où il habite
  phone        String?
  /// Occupations cochées, avec le détail de chacune :
  /// [{ "kind": "student", "detail": "informatique" }, ...]
  occupations  Json?
  languages    String[]  @default([]) // langues parlées
  englishLevel String? // beginner | elementary | intermediate | advanced
  interests    String[]  @default([]) // centres d'intérêt
  photo        Bytes? // la photo du membre (petite image)
  photoType    String? // ex : image/jpeg
  completedAt  DateTime? // rempli = formulaire terminé
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@map("profile")
}

// ===================================================================
// Appels vidéo
// ===================================================================

/// Un appel vidéo. Son id sert aussi de nom de salle dans LiveKit.
model Call {
  id           String            @id @default(cuid())
  createdById  String
  createdBy    User              @relation("CallsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  participants CallParticipant[]

  @@index([createdById])
  @@map("call")
}

/// Une personne qui a le droit d'entrer dans l'appel (le créateur aussi).
model CallParticipant {
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId])
  @@map("call_participant")
}

// ===================================================================
// Salles de groupe, événements, recherche d'appel au hasard
// ===================================================================

/// Une salle de groupe ouverte à tous les membres. Salle LiveKit : "room_<id>".
model Room {
  id          String   @id @default(cuid())
  name        String
  topic       String?
  createdById String
  createdBy   User     @relation("RoomsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@map("room")
}

/// Un événement du club (cours programmé...) ou une annonce de l'admin.
model Event {
  id          String    @id @default(cuid())
  kind        String // "event" (avec date) | "announcement" (annonce)
  title       String
  description String?
  startsAt    DateTime? // la date du cours/événement (null pour une annonce)
  image       Bytes? // l'image de la carte (facultative)
  imageType   String? // ex : image/jpeg
  createdAt   DateTime  @default(now())

  @@index([kind, startsAt])
  @@map("event")
}

/// File d'attente du "practice with a random partner" : une ligne = une personne qui cherche.
model MatchQueue {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("match_queue")
}
